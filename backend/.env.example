# ==============================================================================
# InbaNaturals Backend Environment Configuration (.env)
# ==============================================================================

# Application & Debug
APP_NAME=InbaNaturals
DEBUG=True

# Database Configuration (MySQL / MariaDB)
DATABASE_URL=mysql+pymysql://root:toor@localhost/inbanaturals

# JWT Security
SECRET_KEY=inba-naturals-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (for token blacklist & cache)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (used for email verification links)
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Production SMTP Configuration
# Choose one of the providers below and uncomment/fill in credentials:
# ==============================================================================

# --- Option A: SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key-here
# SMTP_FROM_EMAIL=orders@inbanaturals.com
# SMTP_FROM_NAME="InbaNaturals"
# SMTP_TLS=True
# SMTP_SSL=False

# --- Option B: AWS Simple Email Service (SES) ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-ses-smtp-username-here
# SMTP_PASS=your-ses-smtp-password-here
# SMTP_FROM_EMAIL=notifications@inbanaturals.com
# SMTP_FROM_NAME="InbaNaturals"
# SMTP_TLS=True
# SMTP_SSL=False

# --- Option C: Gmail SMTP (App Password) ---
# Note: Requires 2FA enabled on Google Account + 16-char App Password from myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM_EMAIL=your-account@gmail.com
# SMTP_FROM_NAME="InbaNaturals"
# SMTP_TLS=True
# SMTP_SSL=False

# --- Option D: Local Development / Mock Mode ---
# Leave SMTP_USER and SMTP_PASS empty to log all emails to terminal output
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="InbaNaturals"
SMTP_TLS=True
SMTP_SSL=False
